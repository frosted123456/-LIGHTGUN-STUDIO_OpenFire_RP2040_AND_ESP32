 #include "OpenFIREmain.h"
+#ifdef USE_AIM_PIPELINE
+// Overlay hooks: the '~' serial channel, telemetry sinks and the aim runtime.
+#include "aim_runtime.h"
+#include "ov2640_capture.h"
+#include <string.h>   // strlen, for the non-blocking sink
+static void aim_serial_sink(const char* line)
+{
+    const size_t n = strlen(line);
+    if ((size_t)Serial.availableForWrite() < n) return;
+    Serial.write((const uint8_t*)line, n);
+}
+static void aim_reply_sink(const char* line)
+{
+    const size_t n = strlen(line);
+    size_t off = 0;
+    const uint32_t t0 = millis();
+    while (off < n && (millis() - t0) < 20u) {
+        const int room = Serial.availableForWrite();
+        if (room <= 0) { delay(1); continue; }
+        const size_t w = ((size_t)room < (n - off)) ? (size_t)room : (n - off);
+        Serial.write((const uint8_t*)line + off, w);
+        off += w;
+    }
+}
+static bool s_sink_installed = false;
+static void aim_announce()
+{
+    aim_set_out(aim_reply_sink);           // replies belong on the port we are on
+    ov2640_set_reply_sink(aim_reply_sink);  // ...including the camera tuner's
+    for (int i = 0; i < 40 && !Serial.availableForWrite(); ++i) delay(25);
+    Serial.print("AIM: pipeline ready (v30) -- send ~ping or ~aimcal?\n");
+}
+static inline void aim_serial_pump()
+{
+    while(Serial.available()) {
+        const int ch = Serial.peek();
+        if(ch < 0) break;
+        if(!aim_serial_rx((char)ch)) break;   // theirs -- leave it in the buffer
+        Serial.read();
+        if(!s_sink_installed) {
+            ov2640_set_line_sink(aim_serial_sink);   // telemetry: drop if full
+            aim_set_out(aim_reply_sink);             // replies: chunked
+            ov2640_set_reply_sink(aim_reply_sink);
+            s_sink_installed = true;
+        }
+    }
+}
+#endif

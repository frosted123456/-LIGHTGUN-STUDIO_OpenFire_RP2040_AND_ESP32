+// Telemetry sink: all-or-nothing, drops when the host is not draining.
+static void aim_line_sink(const char* line)
+{
+    const size_t n = strlen(line);
+    if ((size_t)Serial.availableForWrite() < n) return;
+    Serial.write((const uint8_t*)line, n);
+}
+// Reply sink: chunked writes with a 20 ms deadline.
+static void aim_reply_sink(const char* line)
+{
+    const size_t n = strlen(line);
+    size_t off = 0;
+    const uint32_t t0 = millis();
+    while (off < n && (millis() - t0) < 20u) {
+        const int room = Serial.availableForWrite();
+        if (room <= 0) { delay(1); continue; }
+        const size_t w = ((size_t)room < (n - off)) ? (size_t)room : (n - off);
+        Serial.write((const uint8_t*)line + off, w);
+        off += w;
+    }
+    // A truncated line still ends: without its '\n' the host glues the
+    // remainder onto the next reply and files the fields under the wrong key.
+    if (off < n) {
+        const uint32_t t1 = millis();
+        while ((millis() - t1) < 5u) {
+            if (Serial.availableForWrite() > 0) { Serial.write((uint8_t)'\n'); break; }
+            delay(1);
+        }
+    }
+}
+static void aim_announce()
+{
+    aim_set_out(aim_reply_sink);
+    wiicam_set_reply_sink(aim_reply_sink);
+    wiicam_set_line_sink(aim_line_sink);
+    for (int i = 0; i < 40 && !Serial.availableForWrite(); ++i) delay(25);
+    Serial.print("AIM: pipeline ready (rp2040-wiicam) -- send ~ping or ~aimcal?\n");
+}
+// Claim our own bytes out of OpenFIRE's Serial stream before their parser runs.
+// While true, core 0 leaves the camera and its I2C bus alone. The serial
+// pump runs on core 1 under DUAL_CORE, so a camdiag or a sensitivity write
+// would otherwise race core 0's 420 Hz GetPosition on the same driver.
+// The hold flag and its acknowledgement live in the wiicam adapter, because
+// OpenFIRE's calibration and verification loops poll the camera too and have
+// to honour the same flag.
+//
+// Takes the camera bus. Returns false if core 0 never acknowledged, which means
+// it is wedged; callers that can afford to wait for a better moment should.
+static bool aim_cam_take()
+{
+    wiicam_aim_cam_hold(1);
+#if defined(ARDUINO_ARCH_RP2040) && defined(DUAL_CORE)
+    // ONLY the other core waits. Called from the core that owns the camera
+    // poll, this wait could never be satisfied -- the loop that would set the
+    // acknowledgement is the very loop being blocked -- and the gun dropped to
+    // about 6 Hz for good. DUAL_CORE is a build switch a user can turn off, so
+    // this is not hypothetical. On the polling core we are already between
+    // polls by construction: the pump runs in that same loop, after the tick.
+    //
+    // And only while core 0 is actually polling. It does so in Run,
+    // Calibration and Verification; anywhere else no acknowledgement is
+    // coming because nothing is reading the camera.
+    const bool polling = (FW_Common::gunMode == FW_Const::GunMode_Run
+                       || FW_Common::gunMode == FW_Const::GunMode_Calibration
+                       || FW_Common::gunMode == FW_Const::GunMode_Verification);
+    if(rp2040.cpuid() == 1 && polling) {
+        for(int i = 0; i < 150 && !wiicam_aim_cam_acked(); ++i) delay(1);
+        delay(1);
+        return wiicam_aim_cam_acked() != 0;
+    }
+#endif
+    delay(2);
+    return true;
+}
+static void aim_cam_give() { wiicam_aim_cam_hold(0); }
+
+static inline void aim_serial_pump()
+{
+    while(Serial.available()) {
+        const int ch = Serial.peek();
+        if(ch < 0) break;
+        if(!aim_serial_rx((char)ch)) break;   // theirs -- leave it in the buffer
+        Serial.read();
+    }
+}
+// Sensitivity goes through OpenFIRE's own persisted setting.
+static void aim_sens_set(int v)
+{
+    // The engine's outputs go down first: this call blocks core 1 for tens of
+    // milliseconds, and the poll that would end a strike lives on core 1 too,
+    // so a shot in flight would hold the coil at full drive for the duration.
+    fx_glue_shutdown();
+    // The bus-take result is honoured, not assumed. SetIrSensitivity writes
+    // three registers with settling delays; starting that while core 0 is
+    // still inside a read puts two masters on the wire. Refused out loud so
+    // the value the tools show is the value the sensor holds -- a silently
+    // skipped write would leave cam? reporting a sensitivity that never
+    // reached the chip.
+    if(!aim_cam_take()) {
+        aim_cam_give();
+        aim_reply_sink("CAM: camera busy -- sensitivity not written, try again\n");
+        return;
+    }
+    FW_Common::SetIrSensitivity((uint32_t)v);
+    aim_cam_give();
+    // (SetIrSensitivity itself marks the overlay's sensor thresholds for
+    // rewriting -- it rewrites register 0x06 from the preset table.)
+}
+static int  aim_sens_get(void)  { return (int)OF_Prefs::profiles[OF_Prefs::currentProfile].irSens; }
+// Persists the profile (SetIrSensitivity alone does not write flash).
+static void aim_sens_save(void)
+{
+    FW_Common::stateFlags |= FW_Const::StateFlag_SavePreferencesEn;
+    FW_Common::SavePreferences();
+}
+// One raw sensor register write, for the blob-size thresholds MAXSIZE (0x06)
+// and MINSIZE (0x1B). The driver keeps its own register-write helper private
+// and offers no way to reach either individually -- sensitivityLevel() only
+// writes fixed presets, and never touches MINSIZE at all -- so this goes to
+// the bus directly, choosing it from the same pins CameraSet chose it from.
+//
+// Called from the serial-pump core, never from the camera poll: the sensor
+// wants settling time after a configuration write, and core 0 cannot spare it.
+// The same bus CameraSet chose, from the same pins. (CameraSet also checks
+// bit 0 of each pin and builds no driver when that fails, which is why the
+// null check at each call site is the real guard.)
+static TwoWire& aim_cam_bus()
+{
+    return (bitRead(OF_Prefs::pins[OF_Const::camSCL], 1) &&
+            bitRead(OF_Prefs::pins[OF_Const::camSDA], 1)) ? Wire1 : Wire;
+}
+
+// One full-mode report: point the sensor at 0x36 and take the bytes. Also
+// poll-core only, and also unheld, because it stands in for the driver's
+// extendedAtomic() at exactly the same place in the loop.
+//
+// A short read is discarded rather than unpacked. The driver does the same,
+// and it matters more here: a full report is 37 bytes and the Wire receive
+// buffer is the one thing between us and a silently truncated frame that
+// still decodes to plausible coordinates.
+static int aim_fullread(unsigned char* buf, int len)
+{
+    if(!FW_Common::dfrIRPos || !buf || len <= 0) return 0;
+    TwoWire& w = aim_cam_bus();
+    w.beginTransmission(0x58);
+    w.write((uint8_t)0x36);
+    if(w.endTransmission()) return 0;
+    if((int)w.requestFrom(0x58, len) != len) {
+        while(w.available()) w.read();
+        return 0;
+    }
+    for(int i = 0; i < len; ++i) buf[i] = (unsigned char)w.read();
+    return 1;
+}
+
+static int aim_blobreg_set(int reg, int val)
+{
+    // No camera, nothing to configure. Reported as a refusal so the overlay
+    // keeps the request and tries again once there is one.
+    if(!FW_Common::dfrIRPos) return 0;
+    TwoWire& w = aim_cam_bus();
+    fx_glue_shutdown();             // this call blocks core 1 for tens of ms
+    if(!aim_cam_take()) {           // core 0 wedged mid-transaction
+        aim_cam_give();
+        return 0;                   // try again on a later tick
+    }
+    w.beginTransmission(0x58);      // 0xB0 >> 1, the sensor's 7-bit address
+    w.write((uint8_t)reg);
+    w.write((uint8_t)val);
+    const int ok = (w.endTransmission() == 0);
+    delay(10);                      // the driver's own settling delay
+    aim_cam_give();
+    return ok;
+}

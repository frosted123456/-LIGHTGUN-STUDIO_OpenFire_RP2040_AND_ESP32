 #include "OpenFIREFeedback.h"
 #include "OpenFIREprefs.h"
 #include "OpenFIREconstant.h"
+#ifdef USE_AIM_PIPELINE
+// Overlay hooks: the '~' serial channel, wiicam front end, shared aim runtime.
+#include "aim_runtime.h"
+#include "wiicam_aim.h"
+#include <string.h>
+// Telemetry sink: all-or-nothing, drops when the host is not draining.
+static void aim_line_sink(const char* line)
+{
+    const size_t n = strlen(line);
+    if ((size_t)Serial.availableForWrite() < n) return;
+    Serial.write((const uint8_t*)line, n);
+}
+// Reply sink: chunked writes with a 20 ms deadline.
+static void aim_reply_sink(const char* line)
+{
+    const size_t n = strlen(line);
+    size_t off = 0;
+    const uint32_t t0 = millis();
+    while (off < n && (millis() - t0) < 20u) {
+        const int room = Serial.availableForWrite();
+        if (room <= 0) { delay(1); continue; }
+        const size_t w = ((size_t)room < (n - off)) ? (size_t)room : (n - off);
+        Serial.write((const uint8_t*)line + off, w);
+        off += w;
+    }
+}
+static void aim_announce()
+{
+    aim_set_out(aim_reply_sink);
+    wiicam_set_reply_sink(aim_reply_sink);
+    wiicam_set_line_sink(aim_line_sink);
+    for (int i = 0; i < 40 && !Serial.availableForWrite(); ++i) delay(25);
+    Serial.print("AIM: pipeline ready (rp2040-wiicam) -- send ~ping or ~aimcal?\n");
+}
+// Claim our own bytes out of OpenFIRE's Serial stream before their parser runs.
+static inline void aim_serial_pump()
+{
+    while(Serial.available()) {
+        const int ch = Serial.peek();
+        if(ch < 0) break;
+        if(!aim_serial_rx((char)ch)) break;   // theirs -- leave it in the buffer
+        Serial.read();
+    }
+}
+// Sensitivity goes through OpenFIRE's own persisted setting.
+static void aim_sens_set(int v) { FW_Common::SetIrSensitivity((uint32_t)v); }
+static int  aim_sens_get(void)  { return (int)OF_Prefs::profiles[OF_Prefs::currentProfile].irSens; }
+// Persists the profile (SetIrSensitivity alone does not write flash).
+static void aim_sens_save(void)
+{
+    FW_Common::stateFlags |= FW_Const::StateFlag_SavePreferencesEn;
+    FW_Common::SavePreferences();
+}

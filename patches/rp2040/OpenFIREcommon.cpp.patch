+#ifdef USE_AIM_PIPELINE
+// A bare two-byte write to a camera register, on the same bus CameraSet chose
+// and from the same pin test. Used only by the format switch below, which runs
+// on the camera-poll core: that core already owns the bus by being the thing
+// that polls, so it must NOT take the overlay's hold -- it would be waiting
+// for an acknowledgement only it can send. This is dfrIRPos->dataFormat()
+// spelled out, because the driver cannot select the full format.
+//
+// It lives here rather than in the sketch because a file-static in the sketch
+// is not reachable from this translation unit.
+static int aim_camreg_raw(int reg, int val)
+{
+    if(!FW_Common::dfrIRPos) return 0;
+    TwoWire& w = (bitRead(OF_Prefs::pins[OF_Const::camSCL], 1) &&
+                  bitRead(OF_Prefs::pins[OF_Const::camSDA], 1)) ? Wire1 : Wire;
+    w.beginTransmission(0x58);      // 0xB0 >> 1, the sensor's 7-bit address
+    w.write((uint8_t)reg);
+    w.write((uint8_t)val);
+    const int ok = (w.endTransmission() == 0);
+    delay(10);                      // the driver's own settling delay
+    return ok;
+}
+#endif

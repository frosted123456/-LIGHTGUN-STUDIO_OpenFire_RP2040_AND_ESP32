# The OpenFIRE checkout is fetched by tools/patch_openfire.py, never committed:
# it is upstream's LGPL source, not ours to redistribute.
OpenFIRE-Firmware-ESP32/
OpenFIRE-Firmware-RP2040/

# Build and editor state.
.pio/
.vscode/*
!.vscode/tasks.json
__pycache__/
*.pyc
*.orig

# The host test suite stays local; it is run before every delivery, not in CI.
hostcheck/

# Local tool output.
tools/aim_fit_cli
tools/calib_out/
pical/calib_out/
.pical-build/
pical*.img
pical*.img.xz

# OpenFIRE gun (VID F143): a stable name and open permissions, so the
# calibration app can reach it without being root-only.
SUBSYSTEM=="tty", ATTRS{idVendor}=="f143", MODE="0666", SYMLINK+="lightgun"
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", MODE="0666"
